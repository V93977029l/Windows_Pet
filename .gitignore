# Godot Engine
.godot/
imported/

# 用户配置文件 - 不提交到仓库
transparent-pet/config/*_user.cfg
transparent-pet/config/pet_config_user.cfg


# GDExtension build artifacts（排除 addons 下的预编译 DLL）
*.o
*.obj
*.lib
*.a
*.exp
*.pdb
*.dll
!transparent-pet/addons/**/*.dll
*.so
*.dylib
*.bc

# SCons build cache
.sconsign.dblite
.sconf_temp
.scons_node_count
.cache/
scons_cache/

# IDE
.idea/
*.code-workspace

# Python
__pycache__/
*.pyc
.venv/
venv/

# Misc
*.log
logs/
cache/
.DS_Store
Thumbs.db

# Godot UID files
*.uid

# Temporary directories
temp-godot-cpp/
temp-godot-cpp-full/

# godot-cpp - only keep compiled libs
gdextension/godot-cpp/*
!gdextension/godot-cpp/bin/
gdextension/godot-cpp/bin/*
!gdextension/godot-cpp/bin/*.lib
!gdextension/godot-cpp/bin/*.a

# 本地 Godot 导出与 CI 产物（由 tools/ci_export.ps1 与本地调试产生，不应提交）
build/
ci_job_log.txt
ci_logs_*.zip

export/

# Test reports
test-reports/
reports/

# ChromaDB 向量数据库（从 errors.json 重建，不提交二进制文件）
tools/vector_db/chroma_db/
