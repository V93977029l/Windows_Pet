# ============================================================================
# 文件：glass_item_manager.gd
# ============================================================================
# 作用：
#     本文件定义了"玻璃项目管理器"(GlassItemManager) 类。它负责管理场景中
#     所有 GlassItem 实例的增删改查、选中状态、拖拽交互以及着色器数据的
#     批量打包。
#
# 设计模式：
#     - 【仓储模式 (Repository Pattern / Collection Manager)】：
#       `GlassItemManager` 充当所有 `GlassItem` 对象的集合容器，提供
#       统一的 CRUD 接口，外部代码不直接操作 item 数组。
#     - 【状态机模式 (State Machine) - 简化版】：
#       拖拽交互分为三个阶段：`start_drag`（开始拖拽）→ `update_drag`（持续拖拽）
#       → `end_drag`（结束拖拽）。通过 `selected_item_index` 和 `drag_offset`
#       维护拖拽状态。
#     - 【观察者模式 (Observer Pattern) - 信号机制】：
#       通过 `item_selected` 和 `item_moved` 信号，将内部状态变更通知给
#       外部观察者（如渲染器、控制面板）。
#
# 架构说明：
#     本管理器是 `LiquidGlassRenderer` 的一个成员（`item_manager` 变量）。
#     渲染器从管理器获取物品列表后打包为着色器 uniform 数组。用户交互
#     （鼠标点击/拖拽）经过管理器处理后，通过信号告知渲染器刷新渲染状态。
#
#     ┌─────────────┐      信号通知      ┌──────────────────┐
#     │  main.gd    │ ─────────────────→ │     渲染器        │
#     │ (输入处理)   │                    │ LiquidGlassRenderer│
#     └──────┬──────┘                    └────────┬─────────┘
#            │ 调用方法                            │ 读取数据
#            ▼                                    ▼
#     ┌─────────────┐                    ┌──────────────────┐
#     │  管理器      │ ←──── 持有 ────── │   GlassItem[]    │
#     │ GlassItemMgr │                    └──────────────────┘
#     └──────────────┘
# ============================================================================

# ============================================================================
# 类：GlassItemManager
# ============================================================================
# 职责：
#     - 管理 GlassItem 的集合（增/删/查/清空）。
#     - 管理选中状态（单选，同时只能选中一个 item）。
#     - 处理拖拽交互逻辑（开始拖拽、更新位置、结束拖拽）。
#     - 为着色器打包物品数据（固定长度数组，不足补零）。
#     - 初始化默认物品布局。
# ============================================================================
class_name GlassItemManager

# ---------------------------------------------------------------------------
# 常量
# ---------------------------------------------------------------------------

# MAX_ITEMS (int)
#     系统支持的最大玻璃物品数量。
#     此常量有两个重要作用：
#       1. 限制 item 数组的容量（防止无限增长导致性能下降）。
#       2. 与着色器端数组长度对齐。着色器中的 `u_itemPositions[MAX_ITEMS]`
#          等 uniform 数组长度必须与此值一致，否则会产生数据错位。
#     当前值为 3：支持在画布上同时显示至多 3 个玻璃形状。
const MAX_ITEMS: int = 3

# ---------------------------------------------------------------------------
# 成员变量
# ---------------------------------------------------------------------------

# items (Array[GlassItem])
#     存储所有玻璃物品的数组。使用强类型 `Array[GlassItem]` 确保类型安全。
#     数组长度受 `MAX_ITEMS` 限制。
var items: Array[GlassItem] = []

# selected_item_index (int)
#     当前被选中（正在拖拽）的物品在 `items` 数组中的索引。
#     值 -1 表示没有选中的物品。
#     在拖拽过程中，此索引保持指向被拖拽的物品；拖拽结束后重置为 -1。
var selected_item_index: int = -1

# drag_offset (Vector2)
#     鼠标点击位置与物品中心点之间的偏移向量。
#     计算方式：drag_offset = item.position - mouse_click_position
#     其作用是让拖拽过程中物品始终保持在鼠标的相对位置不变，避免
#     物品"跳"到鼠标正下方。
var drag_offset: Vector2 = Vector2.ZERO

# ---------------------------------------------------------------------------
# 信号
# ---------------------------------------------------------------------------

# item_selected(index: int)
#     当用户成功选中一个物品时触发。
#     参数 index 为被选中物品在 items 数组中的索引。
#     用于通知控制面板等 UI 组件更新选中高亮状态。
signal item_selected(index: int)

# item_moved(index: int, position: Vector2)
#     当用户拖拽物品导致其位置变化时触发。
#     参数 index 为被移动物品的索引，position 为物品的新坐标。
#     渲染器可以监听此信号来实现即时重绘，而不是每帧轮询。
signal item_moved(index: int, position: Vector2)

# ============================================================================
# 方法：_init()
# ============================================================================
# 构造函数。初始化空的物品数组。
# ============================================================================
func _init():
	items = []

# ============================================================================
# 方法：add_item(item: GlassItem) → int
# ============================================================================
# 参数：
#     item (GlassItem) - 要添加的 GlassItem 实例。
#
# 返回值：
#     int - 新物品在数组中的索引（0~2）。
#           -1 表示添加失败（数组已满，达到 MAX_ITEMS 限制）。
#
# 核心逻辑：
#     1. 检查当前物品数量是否已达上限。
#     2. 若未满，将 item 追加到数组末尾。
#     3. 返回新物品的索引。
#
# 限制：
#     最多只能存储 MAX_ITEMS（3）个物品。此限制是为了与着色器端
#     固定长度的 uniform 数组对齐，避免 GPU 端数组越界。
# ============================================================================
func add_item(item: GlassItem) -> int:
	if items.size() >= MAX_ITEMS:
		return -1
	items.append(item)
	return items.size() - 1

# ============================================================================
# 方法：remove_item(index: int) → bool
# ============================================================================
# 参数：
#     index (int) - 要删除的物品在数组中的索引。
#
# 返回值：
#     bool - true 表示成功删除，false 表示索引越界。
#
# 核心逻辑：
#     1. 检查索引合法性（是否在 [0, items.size()-1] 范围内）。
#     2. 从数组中移除指定位置的对象。
#     3. 维护 selected_item_index 的一致性：
#        - 若删除的正是选中的物品 → 将 selected_item_index 置为 -1
#        - 若选中的物品位于被删除物品之后 → selected_item_index 减 1
#          （因为数组索引整体前移了一位）
#        - 若选中的物品位于被删除物品之前 → 索引不受影响
# ============================================================================
func remove_item(index: int) -> bool:
	if index < 0 or index >= items.size():
		return false
	items.remove_at(index)
	if selected_item_index == index:
		selected_item_index = -1
	elif selected_item_index > index:
		selected_item_index -= 1
	return true

# ============================================================================
# 方法：get_item(index: int) → GlassItem | null
# ============================================================================
# 参数：
#     index (int) - 要获取的物品索引。
#
# 返回值：
#     GlassItem | null - 索引合法时返回对应的 GlassItem，否则返回 null。
#
# 核心逻辑：
#     简单的边界检查 + 数组访问。为外部代码提供安全的按索引访问方式。
# ============================================================================
func get_item(index: int) -> GlassItem:
	if index < 0 or index >= items.size():
		return null
	return items[index]

# ============================================================================
# 方法：get_items() → Array[GlassItem]
# ============================================================================
# 参数：无
#
# 返回值：
#     Array[GlassItem] - 所有物品的数组引用。
#
# 注意：
#     返回的是内部数组的引用（非拷贝），调用方可以直接修改数组内容。
#     如果需要防篡改，调用方应自行拷贝。
# ============================================================================
func get_items() -> Array[GlassItem]:
	return items

# ============================================================================
# 方法：select_item_at_position(position: Vector2) → int
# ============================================================================
# 参数：
#     position (Vector2) - 屏幕点击/悬停的坐标（视口坐标系）。
#
# 返回值：
#     int - 命中物品的索引。若没有物品在指定位置，返回 -1。
#
# 核心逻辑（从后向前遍历，实现"绘制层级命中"）：
#     1. 从数组末尾向前遍历（后添加的物品渲染在上层，因此应优先被选中）。
#     2. 对于每个启用的物品，调用其 `contains_point()` 方法进行
#        AABB（轴对齐包围盒）碰撞检测。
#     3. 命中首个包含该点的物品后，记录索引、触发 `item_selected` 信号、
#        返回索引。
#     4. 若遍历完毕未命中任何启用物品，重置 selected_item_index 为 -1。
#
# 为什么要从后向前遍历？
#     后添加到数组的物品在视觉上位于更上层（后渲染覆盖先渲染），
#     因此点击检测应优先匹配上层物品。反向遍历天然实现了"Z 序命中"。
# ============================================================================
func select_item_at_position(position: Vector2) -> int:
	for i in range(items.size() - 1, -1, -1):
		var item = items[i]
		if item.enabled and item.contains_point(position):
			selected_item_index = i
			item_selected.emit(selected_item_index)
			return i
	selected_item_index = -1
	return -1

# ============================================================================
# 方法：start_drag(position: Vector2) → bool
# ============================================================================
# 参数：
#     position (Vector2) - 鼠标按下的位置（视口坐标系）。
#
# 返回值：
#     bool - true 表示成功开始拖拽（命中了某个物品），false 表示未命中。
#
# 核心逻辑（拖拽起始阶段）：
#     1. 调用 `select_item_at_position()` 尝试选中一个物品。
#     2. 若选中成功，计算 drag_offset：
#        drag_offset = item.position - position
#        这个偏移量确保在后续 `update_drag` 中，物品跟随鼠标时能够保持
#        相对位置不变，不会突然"跳"到鼠标正下方。
#
# 与 `update_drag` / `end_drag` 的协作：
#     这三个方法组成一个完整的拖拽状态机：
#       start_drag  →  设置 drag_offset 和 selected_item_index
#       update_drag →  使用 drag_offset 更新物品位置
#       end_drag    →  清除拖拽状态
# ============================================================================
func start_drag(position: Vector2) -> bool:
	var index = select_item_at_position(position)
	if index >= 0:
		var item = items[index]
		drag_offset = item.position - position
		return true
	return false

# ============================================================================
# 方法：update_drag(position: Vector2)
# ============================================================================
# 参数：
#     position (Vector2) - 鼠标移动后的新位置（视口坐标系）。
#
# 返回值：无
#
# 核心逻辑（拖拽持续阶段）：
#     1. 检查 selected_item_index 是否有效（>= 0 且在数组范围内）。
#     2. 将物品的位置更新为：鼠标新位置 + drag_offset。
#        这样物品始终保持在鼠标的相对位置，视觉上是"抓住"的效果。
#     3. 触发 `item_moved` 信号，通知渲染器刷新渲染。
#
# 每帧调用位置：
#     此方法应在 `_input()` 中处理 `InputEventMouseMotion` 时调用。
#     由于 `_input()` 的触发频率与鼠标刷新率一致（通常 60~240 Hz），
#     因此拖拽响应非常流畅。
# ============================================================================
func update_drag(position: Vector2):
	if selected_item_index >= 0 and selected_item_index < items.size():
		var item = items[selected_item_index]
		item.position = position + drag_offset
		item_moved.emit(selected_item_index, item.position)

# ============================================================================
# 方法：end_drag()
# ============================================================================
# 参数：无
# 返回值：无
#
# 核心逻辑（拖拽结束阶段）：
#     重置拖拽状态：
#       - selected_item_index 置为 -1（取消选中）
#       - drag_offset 置为零向量
#     注意：不改变物品位置 —— 物品已停留在最后一次 `update_drag` 的位置。
#
# 调用时机：
#     在 `_input()` 中处理鼠标左键释放事件（MOUSE_BUTTON_LEFT && !pressed）时调用。
# ============================================================================
func end_drag():
	selected_item_index = -1
	drag_offset = Vector2.ZERO

# ============================================================================
# 方法：get_selected_item() → GlassItem | null
# ============================================================================
# 参数：无
#
# 返回值：
#     GlassItem | null - 当前选中的物品对象，无选中时返回 null。
#
# 核心逻辑：
#     验证 selected_item_index 的有效性后返回对应的物品。
#     这是一个便捷方法，让外部代码无需关心索引有效性检查。
# ============================================================================
func get_selected_item() -> GlassItem:
	if selected_item_index >= 0 and selected_item_index < items.size():
		return items[selected_item_index]
	return null

# ============================================================================
# 方法：clear_all()
# ============================================================================
# 参数：无
# 返回值：无
#
# 核心逻辑：
#     清空所有物品并重置选中状态。
#     通常在重新初始化场景或重置默认布局时调用。
# ============================================================================
func clear_all():
	items.clear()
	selected_item_index = -1
