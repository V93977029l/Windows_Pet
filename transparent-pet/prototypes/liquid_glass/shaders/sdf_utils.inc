// ================================================================
// sdCircle —— 圆形符号距离函数 (Signed Distance Function)
// ================================================================
// 数学原理：对于圆心在原点、半径为 r 的圆，任意点 p 到圆边缘的
// 有符号距离 = 点到圆心距离 - 半径。
// 返回值 < 0 表示点在圆内，> 0 表示点在圆外，= 0 表示正好在边缘。
// 这是最简单的 SDF 基元，所有复杂 SDF 都建立在此类基本运算之上。
//
//   p: 待评估的2D坐标点（相对于圆心）
//   r: 圆的半径（世界单位）
//   返回: 有符号距离值
float sdCircle(vec2 p, float r) {
    return length(p) - r;
}

// ================================================================
// superellipseCornerSDF —— 超椭圆角 SDF
// ================================================================
// 数学原理：超椭圆（Superellipse）是 Lamé 曲线的特例，其方程满足：
//   |x/a|^n + |y/b|^n = 1
// 当 n=2 时退化为普通椭圆；当 n→∞ 时趋近于矩形。
// 此函数用于计算半径为 r、指数为 n 的超椭圆的有符号距离。
//
// 为什么用超椭圆而不是普通圆角？因为超椭圆能生成介于圆形和方形之间
// 的连续过渡形状，n 值控制"方度"，可以创造出类似 iOS 图标的连续曲率角。
//
// 算法步骤：
//   1. 取 p 的绝对值（利用对称性，只处理第一象限）
//   2. 计算超椭圆的 Ln 范数：v = (|x|^n + |y|^n)^(1/n)
//   3. SDF = v - r（类比圆的 length(p) - r）
//
//   p: 待评估的2D坐标点（相对于圆心）
//   r: 超椭圆角半径（控制角的大小）
//   n: 超椭圆指数（n=2为普通圆角，n越大角越方，n越小角越尖）
//   返回: 有符号距离值
float superellipseCornerSDF(vec2 p, float r, float n) {
    p = abs(p);
    float v = pow(pow(p.x, n) + pow(p.y, n), 1.0 / n);
    return v - r;
}

// ================================================================
// roundedRectSDF —— 超椭圆圆角矩形的符号距离函数
// ================================================================
// 数学原理：将矩形分解为"内部区域"和"角区域"两部分处理。
//
// 关键技巧：利用符号距离场的组合性质——
// - 当点在角区域（d.x > -cr && d.y > -cr）：使用超椭圆角 SDF
// - 当点不在角区域：使用标准矩形 SDF 公式
//   min(max(d.x, d.y), 0.0) + length(max(d, 0.0))
//
// 矩形 SDF 公式解读：
//   - max(d.x, d.y) 表示点距离矩形边框的最大轴分量
//   - min(..., 0.0) 确保点在矩形内部时该部分为负
//   - length(max(d, 0.0)) 计算点超出矩形时的外部欧氏距离
//   两者相加得到完整的有符号距离
//
//   p:            待评估的2D坐标点（世界坐标）
//   center:       矩形中心点坐标
//   width:        矩形宽度（世界单位）
//   height:       矩形高度（世界单位）
//   cornerRadius: 圆角半径（世界单位）
//   n:            超椭圆指数（传递给 superellipseCornerSDF）
//   dpr:          设备像素比，用于将逻辑像素转换为物理像素
//   返回:         有符号距离值
float roundedRectSDF(vec2 p, vec2 center, float width, float height, float cornerRadius, float n, float dpr) {
    // 将坐标变换到以矩形中心为原点的局部坐标系
    p -= center;
    // 将圆角半径从逻辑像素转换为物理像素
    float cr = cornerRadius * dpr;
    // 计算点到矩形半尺寸边界的有符号距离向量
    vec2 d = abs(p) - vec2(width * dpr, height * dpr) * 0.5;

    float dist;
    if (d.x > -cr && d.y > -cr) {
        // 点位于角区域：
        // sign(p) 确定当前在哪个角（右上/左上/右下/左下）
        // cornerCenter 计算该角超椭圆的中心位置
        vec2 cornerCenter = sign(p) * (vec2(width * dpr, height * dpr) * 0.5 - vec2(cr));
        vec2 cornerP = p - cornerCenter;
        dist = superellipseCornerSDF(cornerP, cr, n);
    } else {
        // 点不在角区域：使用标准矩形 SDF 公式
        dist = min(max(d.x, d.y), 0.0) + length(max(d, vec2(0.0)));
    }

    return dist;
}

// ================================================================
// smin —— 平滑最小值函数 (Smooth Minimum)
// ================================================================
// 数学原理：Inigo Quilez 发明的多项式平滑最小值。
// 标准 min(a,b) 在 a=b 处不可导（有棱角），smin 通过在过渡区域
// 减去一个二次多项式 k*h*(1-h) 来产生平滑的混合效果。
//
// 算法步骤：
//   1. h = clamp(0.5 + 0.5*(b-a)/k, 0, 1) —— 计算混合权重
//      当 a << b 时 h→0（选a），当 a >> b 时 h→1（选b）
//   2. 线性插值 mix(b, a, h) —— 在h处取a和b的加权混合
//   3. 减去 k*h*(1-h) —— 在过渡区产生凹入效果，使两个形状"融合"
//
//   k 参数控制平滑度：k 越大，融合范围越宽，过渡越柔和
//   k=0 时退化为标准 min 函数
//
//   a, b: 两个待混合的 SDF 距离值
//   k:    平滑混合系数（>0，越大越平滑）
//   返回: 平滑混合后的距离值
float smin(float a, float b, float k) {
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

// ================================================================
// bezier3 —— 三次贝塞尔曲线求值
// ================================================================
// 数学原理：三次贝塞尔曲线由4个控制点定义，其参数方程为：
//   B(t) = (1-t)³·P₀ + 3(1-t)²t·P₁ + 3(1-t)t²·P₂ + t³·P₃
// 其中 t ∈ [0,1]
//
// 为什么用三次贝塞尔？因为它是计算机图形学中最常用的曲线形式，
// 具有仿射不变性、凸包性质，且能精确表示圆弧之外的复杂曲线。
// 史莱姆的轮廓（顶部弧线和侧面弧线）用贝塞尔曲线来描述非常自然。
//
//   a: 起始控制点 P₀（t=0 对应位置）
//   b: 第一控制柄 P₁（控制起始方向）
//   c: 第二控制柄 P₂（控制终点方向）
//   d: 终点控制点 P₃（t=1 对应位置）
//   t: 参数值（范围 0~1）
//   返回: 曲线上 t 位置处的2D坐标
vec2 bezier3(vec2 a, vec2 b, vec2 c, vec2 d, float t) {
    float u = 1.0 - t;
    return u*u*u * a + 3.0*u*u*t * b + 3.0*u*t*t * c + t*t*t * d;
}

// ================================================================
// sdBezier —— 三次贝塞尔曲线的符号距离函数
// ================================================================
// 数学原理：计算空间中一点 p 到三次贝塞尔曲线的最短距离。
// 这是一个典型的"点到参数曲线最短距离"问题的数值解法。
//
// 算法采用两阶段策略（粗搜索 + 精搜索）：
//
// 【阶段一：均匀采样粗搜索】
//   在 t ∈ [0,1] 上等距采样12个点（0, 1/12, 2/12, ..., 1），
//   选出距离 p 最近的那个采样点的 t 值作为牛顿法的初始猜测。
//   为什么用12个采样点？在精度和性能之间取得平衡——
//   太少的采样可能错过真实最近点（特别是曲线弯曲剧烈时），
//   太多则浪费计算。
//
// 【阶段二：牛顿-拉弗森迭代精搜索】
//   目标：最小化 f(t) = |B(t) - p|² / 2
//   一阶导数：f'(t) = (B(t) - p) · B'(t)
//   二阶导数：f''(t) = B'(t) · B'(t) + (B(t) - p) · B''(t)
//   牛顿更新：t_new = t - f'(t) / f''(t)
//
//   贝塞尔曲线的一阶导数（速度方向）：
//     B'(t) = 3(1-t)²(P₁-P₀) + 6(1-t)t(P₂-P₁) + 3t²(P₃-P₂)
//
//   贝塞尔曲线的二阶导数（加速度方向）：
//     B''(t) = 6(1-t)(P₂-2P₁+P₀) + 6t(P₃-2P₂+P₁)
//
//   最多迭代6次，如果导数接近0（|f''|<ε）则提前终止
//   每次迭代后 clamp t 到 [0,1] 确保不越界
//
//   p: 待评估的空间点
//   a: 贝塞尔曲线控制点 P₀
//   b: 贝塞尔曲线控制点 P₁
//   c: 贝塞尔曲线控制点 P₂
//   d: 贝塞尔曲线控制点 P₃
//   返回: 点 p 到贝塞尔曲线的最短距离（始终 ≥ 0）
float sdBezier(vec2 p, vec2 a, vec2 b, vec2 c, vec2 d) {
    float best_t = 0.0;
    float best_d2 = 1e10; // 初始化为极大值

    // ========== 阶段一：均匀采样搜索 ==========
    // 在12个等距采样点中寻找距离最小的t值
    const int SAMPLES = 12;
    for (int i = 0; i <= SAMPLES; i++) {
        float t = float(i) / float(SAMPLES);
        vec2 q = bezier3(a, b, c, d, t);
        float d2 = dot(q - p, q - p); // 平方距离，避免开根计算
        if (d2 < best_d2) { best_d2 = d2; best_t = t; }
    }

    // ========== 阶段二：牛顿-拉弗森迭代 ==========
    float t = clamp(best_t, 0.0, 1.0); // 从最佳采样点出发
    for (int i = 0; i < 6; i++) {
        vec2 B = bezier3(a, b, c, d, t);       // 曲线上当前位置
        float u = 1.0 - t;
        // B'(t)：贝塞尔曲线的一阶导数（切线/速度向量）
        vec2 dB = 3.0*u*u*(b-a) + 6.0*u*t*(c-b) + 3.0*t*t*(d-c);
        // B''(t)：贝塞尔曲线的二阶导数（法向/加速度向量）
        vec2 ddB = 6.0*u*(c - 2.0*b + a) + 6.0*t*(d - 2.0*c + b);
        // f = (B-p)·B' = 距离函数的一阶导数
        float f = dot(B - p, dB);
        // df = B'·B' + (B-p)·B'' = 距离函数的二阶导数
        float df = dot(dB, dB) + dot(B - p, ddB);
        if (abs(df) < 1e-9) break; // 导数为零，已收敛
        t -= f / df;               // 牛顿更新
        t = clamp(t, 0.0, 1.0);    // 限制在定义域内
    }
    // 返回最终距离（开根得到实际距离）
    return length(bezier3(a, b, c, d, t) - p);
}

// ================================================================
// sdSegment —— 线段的符号距离函数
// ================================================================
// 数学原理：计算点 p 到线段 AB 的最短距离。
//
// 算法步骤（向量投影法）：
//   1. pa = p - a（p相对于A的向量）
//   2. ba = b - a（线段的方向向量）
//   3. h = clamp(dot(pa, ba) / dot(ba, ba), 0, 1)
//      —— 计算 p 在 AB 上的投影参数，clamp到[0,1]确保投影点在线段上
//   4. 距离 = |pa - ba*h|（p到投影点的距离）
//
// 为什么用 dot(pa,ba)/dot(ba,ba)？
//   → 这是向量投影公式：pa 在 ba 方向上的标量投影
//     标量投影 = (pa·ba) / |ba|，再除以 |ba| 得到沿 ba 的比例因子
//
//   p: 待评估的空间点
//   a: 线段起点
//   b: 线段终点
//   返回: 点 p 到线段 AB 的最短距离
float sdSegment(vec2 p, vec2 a, vec2 b) {
    vec2 pa = p - a, ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h);
}

// ================================================================
// halfWidth —— 给定y坐标求史莱姆轮廓的半宽度
// ================================================================
// 数学原理：二分查找法在贝塞尔曲线上反求 x 值。
// 史莱姆的轮廓由两段贝塞尔曲线描述：
//   - 上半部分 (y ≤ 0.11)：右侧上半弧线 ru → 从顶部到最宽点
//   - 下半部分 (y > 0.11)：右侧下半弧线 rl → 从最宽点到底部
//
// 算法步骤：对于给定的 y 坐标，在对应的贝塞尔曲线上进行
// 二分查找（最多20次迭代），找到曲线上 y 分量等于目标 y 的点，
// 然后返回该点的 x 分量作为半宽度。
//
// 为什么用二分查找？
//   → 直接从参数 t 求坐标容易（正向计算），但反过来从坐标求 t
//     需要数值求解。二分查找在这里足够高效且稳定，
//     因为贝塞尔曲线是单调的（在史莱姆轮廓中 y 对 t 单调递增）。
//
//   y:    目标 y 坐标
//   ru_*: 上半贝塞尔曲线的4个控制点（右半侧）
//   rl_*: 下半贝塞尔曲线的4个控制点（右半侧）
//   返回: 在给定 y 处的史莱姆半宽度（x 坐标，始终为正）
float halfWidth(float y, vec2 ru_a, vec2 ru_b, vec2 ru_c, vec2 ru_d,
                        vec2 rl_a, vec2 rl_b, vec2 rl_c, vec2 rl_d) {
    if (y <= 0.11) {
        // y 在上半部分：搜索上半弧线
        float lo = 0.0, hi = 1.0;
        for (int i = 0; i < 20; i++) {
            float mid = (lo + hi) * 0.5;
            float ym = bezier3(ru_a, ru_b, ru_c, ru_d, mid).y;
            if (ym < y) { lo = mid; } else { hi = mid; }
        }
        return bezier3(ru_a, ru_b, ru_c, ru_d, (lo+hi)*0.5).x;
    } else {
        // y 在下半部分：搜索下半弧线
        float lo = 0.0, hi = 1.0;
        for (int i = 0; i < 20; i++) {
            float mid = (lo + hi) * 0.5;
            float ym = bezier3(rl_a, rl_b, rl_c, rl_d, mid).y;
            if (ym < y) { lo = mid; } else { hi = mid; }
        }
        return bezier3(rl_a, rl_b, rl_c, rl_d, (lo+hi)*0.5).x;
    }
}

// ================================================================
// sdSlime —— 史莱姆形状的完整符号距离函数
// ================================================================
// 数学原理：将史莱姆形状分解为三个边界组件，分别计算 SDF，然后
// 通过取最小值的方式组合成一个完整的有符号距离场。
//
// 史莱姆形状的几何分解（基于 SVG 路径数据）：
//   ┌─────────────────────────────────────────┐
//   │  顶部（y ≈ -0.231，X轴镜像对称）         │
//   │  ╭──────────────────────────────╮        │
//   │  │   上半贝塞尔弧线（ru）       │        │
//   │  │   P₀(0,-.231) → P₃(.4,.11)  │        │
//   │  │                              │        │
//   │  │   下半贝塞尔弧线（rl）       │        │
//   │  │   P₀(.4,.11) → P₃(.25,.275) │        │
//   │  ╰──────────────────────────────╯        │
//   │       底部直线 (.25,.275)→(-.25,.275)   │
//   └─────────────────────────────────────────┘
//
// 三个 SDF 组件：
//   d_ru: 右上弧线（upper right bezier）- 从顶部到最宽处
//   d_rl: 右下弧线（lower right bezier）- 从最宽处到底部
//   d_bt: 底部直线段（bottom segment）
//
// 利用 X 轴镜像对称性（abs(p.x)），只需要计算右半侧。
//
// 内部/外部判定（halfWidth 回退方案）：
//   对于 SDF 精度不足的复杂区域，使用 halfWidth 进行精确的
//   内部测试：如果点满足 y 在轮廓范围内且 |x| ≤ 半宽度，
//   则该点在史莱姆内部。
//
//   p: 待评估的2D坐标点（归一化空间）
//   返回: 有符号距离（内部为负，外部为正）
float sdSlime(vec2 p) {
    // 利用 X 轴镜像对称性，只处理右半侧
    float ax = abs(p.x);

    // 计算到右上弧线（上半贝塞尔）的最近距离
    float d_ru = sdBezier(vec2(ax, p.y),
        vec2(0.0, -0.231), vec2(0.25, -0.231), vec2(0.4, -0.055), vec2(0.4, 0.11));

    // 计算到右下弧线（下半贝塞尔）的最近距离
    float d_rl = sdBezier(vec2(ax, p.y),
        vec2(0.4, 0.11), vec2(0.4, 0.22), vec2(0.325, 0.275), vec2(0.25, 0.275));

    // 计算到底部直线的最近距离
    float d_bt = sdSegment(vec2(ax, p.y), vec2(0.25, 0.275), vec2(-0.25, 0.275));

    // 取三个 SDF 的最小值（点到最近边界的距离）
    float d = min(min(d_ru, d_rl), d_bt);

    // 精确内部测试：
    // 1. y 必须在轮廓的垂直范围内
    // 2. |x| 必须不超过该 y 处的半宽度
    bool inside = p.y > -0.232 && p.y < 0.276 && ax <= halfWidth(p.y,
        vec2(0.0, -0.231), vec2(0.25, -0.231), vec2(0.4, -0.055), vec2(0.4, 0.11),
        vec2(0.4, 0.11), vec2(0.4, 0.22), vec2(0.325, 0.275), vec2(0.25, 0.275));

    // 内部返回负值，外部返回正值
    return inside ? -d : d;
}
